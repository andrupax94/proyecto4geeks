{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Ejecutar como módulo (src)",
            "type": "debugpy",
            "request": "launch",
            // Ejecuta el archivo actual como módulo
            "module": "src.${relativeFileDirname}/${fileBasenameNoExtension}",
            // Asegura que la raíz del proyecto es el cwd
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}