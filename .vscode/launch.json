{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Next.js Frontend",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm --prefix deployment/frontend run dev",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "outFiles": [
                "${workspaceFolder}/deployment/frontend/.next/**/*.js"
            ]
        },
        {
            "name": "Next.js Frontend Internet",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run start",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "outFiles": [
                "${workspaceFolder}/deployment/frontend/.next/**/*.js"
            ]
        },
        {
            "name": "FastAPI Backend",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "deployment.backend.app.main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": false,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ],
    "compounds": [
        {
            "name": "Full Stack",
            "configurations": [
                "Next.js Frontend",
                "FastAPI Backend"
            ]
        },
        {
            "name": "Full Stack Internet",
            "configurations": [
                "Next.js Frontend Internet",
                "FastAPI Backend"
            ]
        }
    ]
}