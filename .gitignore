
# description: Rules to exclude files and folders from version control; covers binaries virtualenvs and build artifacts
# owner: Dev
# priority: Minimum
# notes: Update when adding new tools or binaries for RPi5 or CI
# context: Version control rules

# ===== Python =====
**/__pycache__/**

**pycache/**
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
.eggs/
pyproject.toml
# ===== Virtualenv =====
rocm_env
venv/
.env/
.env.local

# ===== OS =====

.DS_Store
Thumbs.db

# ===== Logs =====
*.zip
*.log

# ===== Modelos LLM (NO subir a Git) =====

*.gguf

model-*.bin

# ===== IDE =====
.vscode/*
.vscode/
.idea/
*.swp
*.wav
data/*/*.wav
data/*/*/*.wav
data/*/*/*/*.wav

data/*/*.npy
data/*/*/*.npy
data/*/*/*/*.npy

proyecto4geeks.egg-info/
# ===== Cache =====
.git/
.cache/
.pytest_cache/
.venv/
# ===== Configuración sensible =====
data/raw/**/*.wav
data/raw/**/*.m4a
data/raw/**/*.webm
config.local.json
secrets.json
settings.local.py
**/sonidos/
pyproject.toml
settings.json
*.npy