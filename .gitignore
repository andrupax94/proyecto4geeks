# =========================================================
# .gitignore
# Reglas para excluir archivos y carpetas del control de versiones
# =========================================================

# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Build / packaging
build/
dist/
site/
.eggs/
*.egg
*.egg-info/

# =========================
# Virtual environments
# =========================
venv/
.venv/
env/
ENV/
rocm_env/

# =========================
# Testing / cache
# =========================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
htmlcov/

# =========================
# IDE / Editor
# =========================
.vscode/*
.vscode/
.idea/
*.swp
*.swo
*.mp3
# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Logs / archives
# =========================
*.log
*.zip

# =========================
# Audio datasets
# =========================
*.wav
*.m4a
*.webm

# Dataset folders
data/raw/
**/sonidos/

# =========================
# NumPy / ML artifacts
# =========================
*.npy

# Model checkpoints
models/checkpoints/

# LLM / model binaries
# =========================
*.gguf
model-*.bin

# =========================
# Sensitive config
# =========================
.env
.env.*
config.local.json
secrets.json
settings.local.py

# =========================
# Project metadata
# =========================
proyecto4geeks.egg-info/

# =========================
# Optional generated configs
# =========================
settings.json